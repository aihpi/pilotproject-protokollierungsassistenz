# HuggingFace token for pyannote diarization (required)
# Create token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# WhisperX configuration
WHISPER_MODEL=large-v2
WHISPER_DEVICE=auto
WHISPER_BATCH_SIZE=16
WHISPER_LANGUAGE=de

# LLM configuration (OpenAI-compatible HTTP API)
# Default: local, self-hosted Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama

# Alternative: remote HPI AISC model hub. To use it, replace the three values
# above with these and set your key:
#   LLM_BASE_URL=https://api.aisc.hpi.de
#   LLM_MODEL=gemma-4-31b
#   LLM_API_KEY=your_api_key_here
#
# --- Swapping in the fine-tuned model ---
# When AISC has loaded the gemma-4-31B-it base + the trained LoRA adapter,
# change ONLY LLM_MODEL to the adapter's served id. Nothing else changes.
# (extract_tops always uses the plain base model; only summarisation needs the adapter.)
#
# Note: confirm with AISC whether the chat/completions path needs a /v1 suffix.
# The OpenAI client appends /chat/completions to LLM_BASE_URL; the hub answers
# 200 both with and without /v1.
