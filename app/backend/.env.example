# HuggingFace token for pyannote diarization (required)
# Create token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# WhisperX configuration
WHISPER_MODEL=large-v2
WHISPER_DEVICE=auto
WHISPER_BATCH_SIZE=16
WHISPER_LANGUAGE=de

# LLM configuration (OpenAI-compatible endpoint; Ollama by default)
LLM_BASE_URL=http://localhost:11434/v1
# API key for the LLM server (server-side only, never sent to the browser).
LLM_API_KEY=ollama
# "Standard" config model.
LLM_MODEL=qwen3:8b
# "Gemma" (Landtagstil) config model. Local stand-in is the BASE gemma4:12b until
# the 12b LoRA adapter is available; then flip to gemma-4-12b-protokoll
# (see docs/local-gemma-lora.md).
GEMMA_MODEL=gemma4:12b
# Which config is selected by default (standard | gemma).
LLM_DEFAULT_CONFIG=standard
