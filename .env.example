# Protokollierungsassistenz - Environment Configuration
# Copy this file to .env to customize settings
#
# NOTE: When using pre-built Docker images from ghcr.io, no configuration
# is required! The default settings work out of the box.

# ==================================================
# OPTIONAL: Whisper Configuration
# ==================================================
# Model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v2

# Device: cpu, cuda, auto (auto-detect)
WHISPER_DEVICE=cpu

# Batch size for transcription (reduce if running out of memory)
WHISPER_BATCH_SIZE=16

# Language code
WHISPER_LANGUAGE=de

# ==================================================
# OPTIONAL: LLM Configuration
# ==================================================
# The app offers two selectable model configurations in the frontend. Both talk
# to the SAME server (LLM_BASE_URL / LLM_API_KEY); they differ only in the model
# name and the system prompt.

# Model for the "Standard" configuration (must be available on the LLM server)
LLM_MODEL=qwen3:8b

# Model for the alternative "Gemma" (Landtagstil) configuration (fixed, non-editable
# prompt). Locally this is the BASE gemma4:12b as a stand-in until the 12b LoRA adapter
# is available; flip to gemma-4-12b-protokoll once it is served locally (see
# docs/local-gemma-lora.md). The cluster uses gemma-4-31b / gemma-4-31b-protokoll.
GEMMA_MODEL=gemma4:12b

# Which configuration is selected by default (standard | gemma)
# LLM_DEFAULT_CONFIG=standard

# LLM server endpoint (OpenAI-compatible). Defaults to a local Ollama instance.
# LLM_BASE_URL=http://localhost:11434/v1

# API key for the LLM server. This is per-user and server-side ONLY; it is never
# sent to the browser. Leave the default for a local Ollama instance.
# LLM_API_KEY=ollama

# ==================================================
# FOR DEVELOPERS ONLY: Building Images Locally
# ==================================================
# HuggingFace token is ONLY needed if you're building Docker images locally
# instead of using the pre-built images from ghcr.io
#
# Get your token at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here
